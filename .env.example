# Copy to .env — docker compose reads it automatically. Every value is optional.

# The one port Keel is served on (http://localhost:8080 by default).
KEEL_PORT=8080

# Turns on the AI features (policy extraction, the ⌘K agent, Insights, evals).
# Without a key the whole deterministic core still works: org graph, rules
# engine, workflows, inbox, impact analysis.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Load the Demo Factorial demo company on first start. "false" begins blank so
# you can assemble your own company from a CSV and a handbook on /assemble.
SEED_DEMO=true

# Public demo only: "true" shows a Reset demo button (Settings, hr_admin) that wipes the
# deployment and reloads Demo Factorial. Destructive, so it is off by default.
DEMO_RESET=false

# Change both before exposing Keel beyond your machine.
DATABASE_PASSWORD=postgres
# openssl rand -hex 64
SECRET_KEY_BASE=

# Encrypts stored integration credentials (Slack webhook URL, Google Calendar
# OAuth tokens) at rest. Generate your own with `bin/rails db:encryption:init`
# before exposing Keel beyond your machine — these three are local-dev-only.
AR_ENCRYPTION_PRIMARY_KEY=rv0wuvmYTMVQaAriKp2HnAxEU1lI3owR
AR_ENCRYPTION_DETERMINISTIC_KEY=WmENU7gr6NXidtOrqkOtZEaR4TnkHDEJ
AR_ENCRYPTION_KEY_DERIVATION_SALT=zLWjNehXbANMjM25wQaEEULQDj2LOXqa

# Optional: connects the Integrations settings panel to Google Calendar.
# Create an OAuth 2.0 Web client in Google Cloud Console (enable the Calendar
# API, set the redirect URI to <your-host>/api/companies/:company_id/integrations/google_calendar/callback)
# and paste its values here. Slack needs no setup here — it's connected from
# inside the app with an incoming webhook URL.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
