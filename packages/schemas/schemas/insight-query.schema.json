{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InsightInterpretation",
  "description": "What Insights::Interpreter returns for a natural-language analytics question (SPEC.md section 11): either a typed query object for Insights::QueryBuilder to run, or a clarifying question when the request is ambiguous — never both. Metrics, group-bys and filter fields are closed whitelists so the LLM can't ask for anything QueryBuilder doesn't have a hand-written scope for. Which group_by each metric allows is checked by QueryBuilder, not here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": { "$ref": "#/$defs/query" },
    "clarification": {
      "type": "string",
      "minLength": 1,
      "description": "A short question back to the user, e.g. 'Do you mean calendar Q3 or your fiscal quarter?'"
    }
  },
  "oneOf": [{ "required": ["query"] }, { "required": ["clarification"] }],
  "$defs": {
    "query": {
      "title": "InsightQuery",
      "type": "object",
      "required": ["metric", "chart"],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "request_count",
            "leave_days",
            "expense_total",
            "approval_load",
            "time_to_decision",
            "override_rate",
            "auto_approval_rate"
          ]
        },
        "group_by": {
          "type": "string",
          "description": "Omit for a single total.",
          "enum": ["department", "kind", "month", "decision", "person", "category", "approver", "rule", "policy"]
        },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/filter" }
        },
        "time_range": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "description": "Inclusive dates, matched against when each request was submitted.",
          "properties": {
            "from": { "type": "string", "format": "date" },
            "to": { "type": "string", "format": "date" }
          }
        },
        "sort": { "type": "string", "enum": ["asc", "desc"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
        "chart": { "type": "string", "enum": ["bar", "line", "pie", "table"] }
      }
    },
    "filter": {
      "title": "InsightFilter",
      "type": "object",
      "required": ["field", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "enum": ["request.kind", "request.decision", "request.status", "requester.department", "payload.category"]
        },
        "op": { "type": "string", "enum": ["eq", "neq", "in"] },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "minItems": 1, "items": { "type": "string" } }
          ]
        }
      }
    }
  }
}
