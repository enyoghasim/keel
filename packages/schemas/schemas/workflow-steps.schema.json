{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowSteps",
  "description": "Task and notify steps the LLM adds to a generated workflow (SPEC.md section 6, stage 5). Approval steps come straight from the policy's require_approval rules, not from the LLM — 'approval' is deliberately not a valid type here.",
  "type": "object",
  "required": ["additional_steps"],
  "additionalProperties": false,
  "properties": {
    "additional_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "type", "assignee"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "type": { "type": "string", "enum": ["task", "notify"] },
          "assignee": {
            "type": "string",
            "description": "A role reference (role:it_admin) or org reference (manager_of(requester)) — never a person's name."
          },
          "title": { "type": "string" },
          "when": { "$ref": "#/$defs/condition" }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["all"],
          "additionalProperties": false,
          "properties": {
            "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          }
        },
        {
          "type": "object",
          "required": ["any"],
          "additionalProperties": false,
          "properties": {
            "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          }
        },
        {
          "type": "object",
          "required": ["field", "op", "value"],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string",
              "enum": [
                "requester.department",
                "requester.location",
                "requester.tenure_months",
                "payload.amount_eur",
                "payload.category",
                "payload.days",
                "payload.notice_days"
              ]
            },
            "op": {
              "type": "string",
              "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "not_in", "between"]
            },
            "value": {}
          }
        }
      ]
    }
  }
}
