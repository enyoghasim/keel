{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CsvMapping",
  "description": "An LLM-proposed mapping from a source CSV's columns to Keel's person fields (SPEC.md section 6, stage 1).",
  "type": "object",
  "required": ["mappings"],
  "additionalProperties": false,
  "properties": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_column", "field", "confidence"],
        "additionalProperties": false,
        "properties": {
          "source_column": {
            "type": "string",
            "description": "The exact header text from the uploaded CSV."
          },
          "field": {
            "type": "string",
            "enum": ["name", "email", "title", "department", "manager", "location", "start_date", "ignore"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
